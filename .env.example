# Copy to `.env` and adjust as needed. `.env` is git-ignored; never commit real
# secrets. Nothing in this module requires a secret to run.

# --- Paths ----------------------------------------------------------------
# Absolute path to the repository root. Only needed when the working directory
# is outside the checkout (the Docker images set this to /app).
# WTPM_PROJECT_ROOT=/app

# Alternative configuration directory, e.g. for an environment-specific
# override of configs/*.yaml.
# WTPM_CONFIG_DIR=configs

# --- Logging --------------------------------------------------------------
# Overridden per-run by configs/base.yaml -> logging.level
# LOG_LEVEL=INFO

# --- Service ports --------------------------------------------------------
WTPM_BIND_ADDRESS=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501

# --- Dashboard ------------------------------------------------------------
# Base URL the dashboard would use if it called the API over HTTP. The current
# dashboard imports FailurePredictionService directly and does not need this;
# it is here for a future deployment that separates the two processes.
# API_BASE_URL=http://localhost:8000
