# Keep the build context small and free of local state.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log
*.pid

# Generated data and artifacts are mounted at runtime, never baked in.
data/raw/*
data/interim/*
data/processed/*
!data/samples/
artifacts/models/*
artifacts/metrics/*
artifacts/figures/*
artifacts/metadata/*

.git/
.github/
notebooks/
tests/
docs/
*.md
!README.md
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
*.db
*.sqlite
*.sqlite3
.DS_Store
